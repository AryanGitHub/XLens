<component type="desktop-application">
  <id>org.gnome.gitlab.Oumuamua.XLens</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>XLens</name>
  <summary>An OCR GTK4 and Libadwaita app</summary>
  <description>
    <p>
    A Optical Character Recognition (OCR) wrapper application for the GNOME desktop, built with GTK4 and Libadwaita.
    </p>
    <p>
    Extract text from images and scanned documents seamlessly with a modern, adaptive user interface.
    </p>
  </description>

  <developer id="org.gnome.gitlab.Oumuamua">
    <name>Aryan Pandey</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://gitlab.gnome.org/Oumuamua/XLens</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://gitlab.gnome.org/Oumuamua/XLens</url>
  <!-- Should point to the software's bug tracking system, for users to report new bugs -->
  <url type="bugtracker">https://gitlab.gnome.org/Oumuamua/XLens/-/work_items</url>

  <!-- This could for example be an HTTPS URL to an online form or a page describing how to contact the developer -->
  <url type="contact">https://aryangithub.github.io/personal-website/contact</url>
  <!-- URLs of this type should point to a webpage showing information on how to contribute to the described software project -->
  <url type="contribute">https://gitlab.gnome.org/Oumuamua/XLens</url>


  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">org.gnome.gitlab.Oumuamua.XLens.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <categories>
    <category>Utility</category>
    <category>Office</category>
    <category>OCR</category>
    <category>Scanning</category>
  </categories>

  <keywords>
    <keyword>ocr</keyword>
    <keyword>text</keyword>
    <keyword>extract</keyword>
    <keyword>image</keyword>
    <keyword>scan</keyword>
    <keyword>recognize</keyword>
    <keyword>document</keyword>
  </keywords>

  <branding>
    <color type="primary" scheme_preference="light">#005aad</color>
    <color type="primary" scheme_preference="dark">#001d61</color>
  </branding>

  <!-- ONLY desktop supported -->
  <requires>
    <control>keyboard</control>
    <control>pointing</control>
    <display_length compare="ge">450</display_length>
  </requires>



<screenshots>
  <screenshot type="default">
    <image>https://raw.githubusercontent.com/AryanGitHub/XLens/1b141b58558a466da064afb67ffcaa2798990d40/screenshots/main-page-dark-mode.png</image>
    <caption>Main Page of XLens App in Dark Mode</caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/AryanGitHub/XLens/1b141b58558a466da064afb67ffcaa2798990d40/screenshots/main-page-light-mode.png</image>
    <caption>Main Page of XLens App in Light Mode</caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/AryanGitHub/XLens/1b141b58558a466da064afb67ffcaa2798990d40/screenshots/from-url-page-dark-mode.png</image>
    <caption>Enter URL of Imag to extract Text, in Dark Mode</caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/AryanGitHub/XLens/1b141b58558a466da064afb67ffcaa2798990d40/screenshots/from-url-page-light-mode.png</image>
    <caption>Enter URL of Imag to extract Text, in Light Mode</caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/AryanGitHub/XLens/1b141b58558a466da064afb67ffcaa2798990d40/screenshots/output-window-dark-mode.png</image>
    <caption>Output Window of XLens App in Dark Mode</caption>
  </screenshot>
  <screenshot>
    <image>https://raw.githubusercontent.com/AryanGitHub/XLens/1b141b58558a466da064afb67ffcaa2798990d40/screenshots/preferences-page-dark-mode.png</image>
    <caption>Preferences Page of XLens App in Dark Mode</caption>
  </screenshot>
</screenshots>


  <releases>
    <release version="0.0.5" date="2026-10-22">
      <description translate="no">
        <p>First Alpha Release</p>
      </description>
    </release>
  </releases>

</component>
