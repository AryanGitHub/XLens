<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name window.ui -->
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="XlensMainWindow" parent="AdwApplicationWindow">
    <property name="default-height">600</property>
    <property name="default-width">350</property>
    <child>
      <object class="AdwToastOverlay" id="toast_overlay">
        <child>
          <object class="AdwNavigationView" id="app_nav_view">
            <child>
              <object class="AdwNavigationPage">
                <property name="tag">main_page</property>
                <property name="title">XLens</property>
                <child>
                  <object class="AdwToolbarView">
                    <property name="content">
                      <object class="GtkBox">
                        <property name="halign">center</property>
                        <property name="orientation">vertical</property>
                        <property name="vexpand">True</property>
                        <property name="width-request">260</property>
                        <child>
                          <object class="GtkGrid">
                            <property name="hexpand">True</property>
                            <property name="margin-bottom">25</property>
                            <property name="orientation">vertical</property>
                            <property name="row-homogeneous">True</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkImage">
                                <property name="file">./image.svg</property>
                                <property name="hexpand">True</property>
                                <property name="icon-size">large</property>
                                <property name="pixel-size">186</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="column-span">1</property>
                                  <property name="row">0</property>
                                  <property name="row-span">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">heading
title-1</property>
                                <property name="justify">center</property>
                                <property name="label">XLens</property>
                                <property name="yalign">0.7</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">document
</property>
                                <property name="label" translatable="yes">Extract Text from Images</property>
                                <property name="valign">start</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkGrid">
                                <property name="orientation">vertical</property>
                                <property name="row-homogeneous">True</property>
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="GtkButton" id="paste_button">
                                    <property name="action-name">win.paste</property>
                                    <property name="css-classes">pill
document</property>
                                    <property name="hexpand">True</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="baseline-position">bottom</property>
                                        <property name="halign">fill</property>
                                        <property name="hexpand">True</property>
                                        <property name="spacing">10</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">edit-paste</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="label">From Paste</property>
                                            <property name="xalign">0.0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="hexpand">True</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="css-classes">dim-label
</property>
                                            <property name="halign">end</property>
                                            <property name="label">Ctrl + V</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="open_button">
                                    <property name="action-name">win.open</property>
                                    <property name="css-classes">pill
document</property>
                                    <property name="hexpand">True</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="baseline-position">bottom</property>
                                        <property name="halign">fill</property>
                                        <property name="hexpand">True</property>
                                        <property name="spacing">10</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">image-x-generic-symbolic</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="label">Open Image</property>
                                            <property name="xalign">0.0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="hexpand">True</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="css-classes">dim-label
</property>
                                            <property name="halign">end</property>
                                            <property name="label">Ctrl + O</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="take_screenshot_button">
                                    <property name="action-name">win.take_screenshot</property>
                                    <property name="css-classes">suggested-action
pill
document</property>
                                    <property name="hexpand">True</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="baseline-position">bottom</property>
                                        <property name="halign">fill</property>
                                        <property name="hexpand">True</property>
                                        <property name="spacing">10</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">camera-photo</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="label">Take Screenshot</property>
                                            <property name="xalign">0.0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="hexpand">True</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="css-classes">dim-label
</property>
                                            <property name="halign">end</property>
                                            <property name="label">Alt+X</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="url_button">
                                    <property name="css-classes">pill
document</property>
                                    <property name="hexpand">True</property>
                                    <property name="valign">center</property>
                                    <signal name="clicked" handler="from_url_button_clicked"/>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="baseline-position">bottom</property>
                                        <property name="halign">fill</property>
                                        <property name="hexpand">True</property>
                                        <property name="spacing">10</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">emblem-symbolic-link</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                            <property name="label">From URL</property>
                                            <property name="xalign">0.0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="hexpand">True</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="css-classes">dim-label
</property>
                                            <property name="halign">end</property>
                                            <property name="label">Ctrl + V</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">3</property>
                                    </layout>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">5</property>
                                  <property name="row-span">4</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="hexpand">True</property>
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <child type="start">
                          <object class="GtkButton">
                            <property name="icon-name">preferences-system</property>
                            <signal name="clicked" handler="menu_button_clicked"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
