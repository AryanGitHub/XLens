<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name textViewer.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.4"/>
  <template class="OutputViewerWindow" parent="AdwApplicationWindow">
    <property name="default-height">400</property>
    <property name="default-width">600</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="outputHeaderTitle"/>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkTextView" id="outputTextView"/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
